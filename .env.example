# Copy to .env.local for local development. Never commit real secrets.

# Public URL of the deployed site (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API key for the chat assistant (https://console.anthropic.com).
# Without it, /api/chat returns 503 and the widget tells visitors the assistant is unavailable.
ANTHROPIC_API_KEY=

# Optional: email corrections to editors through Resend (https://resend.com).
# Without these, submissions are written to the server log.
RESEND_API_KEY=
CORRECTIONS_EMAIL_TO=editor@example.com
CORRECTIONS_EMAIL_FROM="Deoria Guide <corrections@your-verified-domain.com>"
